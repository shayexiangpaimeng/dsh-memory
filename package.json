{
  "name": "@shayexiangpaimeng/dsh-memory",
  "description": "Append-only layered memory for DeepSeek Harness agents: five-layer partitioning, write-gate checks, keyword recall, and claim-anchors verification",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./storage": {
      "types": "./lib/storage.d.ts",
      "default": "./lib/storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayexiangpaimeng/dsh-memory.git"
  },
  "keywords": [
    "dsh-plugin",
    "memory",
    "agent",
    "deepseek-harness"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
